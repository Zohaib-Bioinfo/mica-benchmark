# Large data and structure files: fetch them with the scripts, never commit them.
# (results/raw/ is committed: it holds only the text files of the sessions, see scripts/ingest_results.py.)
# Use `git add -f <file>` for the few small files you want to share.
*.map
*.map.gz
*.mrc
*.ccp4
*.cif
*.cif.gz
*.pdb
*.tar.gz
*.zip
/inputs/
/outputs/
/work/

# Secrets: never commit
kaggle.json
.env
*.key
phenix_credentials*
*password*

# Python and notebooks
__pycache__/
.ipynb_checkpoints/
*.pyc
.venv/

# AlphaFold Server predictions: the terms allow non-commercial research use only, so they stay private.
# The check table and the file hashes in data/af3/ are public.
af3_models/
fold_*

# LaTeX build folder of the report (the PDF in report/ is kept)
report/build/
